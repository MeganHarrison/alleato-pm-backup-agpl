{
  "name": "Collection Analysis Production Canary",
  "description": "Semantic collection-analysis variants scored only from persisted execution evidence and latency.",
  "defaultWarnDurationMs": 120000,
  "defaultMaxDurationMs": 240000,
  "globalForbiddenPhrases": [],
  "toolFamilyMap": {},
  "evalBundles": {
    "collection-analysis-production-canary": {
      "description": "Weekly evidence-gated collection analysis canary against the canonical production assistant.",
      "filter": "^collection-analysis-canary-",
      "warnDurationMs": 120000,
      "maxDurationMs": 240000,
      "requireCollectionSourceParity": true,
      "criteria": [
        "Natural-language variants must reach semantic collection analysis without evaluator keyword matching.",
        "Persisted coverage must be exhaustive, failure-free, non-empty, and internally consistent.",
        "Every retrieved meeting must have one unique canonical persisted source.",
        "The production request must finish within the hard latency budget."
      ]
    }
  },
  "cases": [
    {
      "id": "collection-analysis-canary-annual-reviews-direct",
      "intent": "source_lookup",
      "prompt": "Read all of the annual reviews and tell me your insights",
      "minAnswerLength": 100,
      "warnDurationMs": 120000,
      "maxDurationMs": 240000,
      "requiredMetadataPaths": [
        "collection_coverage",
        "collection_synthesis",
        "retrieval_plan"
      ],
      "redactResponseContentInArtifacts": true,
      "collectionAudit": {
        "requireExhaustive": true,
        "requireZeroFailures": true,
        "minimumMatched": 1,
        "requireCandidateMatchesEqualsEnumerated": true,
        "requireAdjudicatedEqualsCandidates": true,
        "requireRetrievedEqualsMatched": true,
        "requireCanonicalSourceCountEqualsRetrieved": true,
        "requireUniqueCanonicalSources": true,
        "requireAllSourcesCanonical": true,
        "requireEmptyFailureList": true,
        "requireSuccessfulSynthesis": true,
        "expectedSynthesisModel": "openai/gpt-5.4",
        "expectedSynthesisMode": "non_reasoning",
        "expectedSynthesisMaxOutputTokens": 4096,
        "expectedSynthesisTimeoutMs": 90000,
        "expectedSelectionContractVersion": "taxonomy-cohort-v5",
        "expectedSelectionModel": "openai/gpt-4.1-mini",
        "expectedSelectionEscalationModel": "openai/gpt-5.4-mini",
        "expectedSelectionVerificationModel": "openai/gpt-5.4-mini",
        "expectedSelectionVerificationMode": "individual-semantic",
        "expectedSelectionBatching": "taxonomy-cohort",
        "expectedCollectionRecordClass": "employee_performance_evaluation",
        "expectedBoundaryContractVersion": "semantic-boundary-v3",
        "expectedBoundaryModel": "openai/gpt-5.4-mini",
        "expectedBoundaryMethod": "semantic-canonicalization",
        "expectedAdvisorContractVersion": "executive-advisor-v12",
        "expectedAdvisorJudgeModel": "openai/gpt-5.4-mini",
        "requireAdvisorContractPassed": true,
        "minimumAdvisorScore": 80,
        "maximumAdvisorAttempts": 4,
        "minimumAdvisorSemanticScore": 4,
        "minimumAdvisorThesisSpecificity": 5,
        "minimumAdvisorExecutiveVoice": 5,
        "expectedArchitecture": "retrieval-planner-v2",
        "expectedProviderPath": "semantic-collection-analysis"
      }
    },
    {
      "id": "collection-analysis-canary-performance-conversations-semantic",
      "intent": "source_lookup",
      "prompt": "Examine every yearly employee evaluation meeting transcript and summarize the recurring strengths, development gaps, risks, and coaching priorities.",
      "minAnswerLength": 100,
      "warnDurationMs": 120000,
      "maxDurationMs": 240000,
      "requiredMetadataPaths": [
        "collection_coverage",
        "collection_synthesis",
        "retrieval_plan"
      ],
      "redactResponseContentInArtifacts": true,
      "collectionAudit": {
        "requireExhaustive": true,
        "requireZeroFailures": true,
        "minimumMatched": 1,
        "requireCandidateMatchesEqualsEnumerated": true,
        "requireAdjudicatedEqualsCandidates": true,
        "requireRetrievedEqualsMatched": true,
        "requireCanonicalSourceCountEqualsRetrieved": true,
        "requireUniqueCanonicalSources": true,
        "requireAllSourcesCanonical": true,
        "requireEmptyFailureList": true,
        "requireSuccessfulSynthesis": true,
        "expectedSynthesisModel": "openai/gpt-5.4",
        "expectedSynthesisMode": "non_reasoning",
        "expectedSynthesisMaxOutputTokens": 4096,
        "expectedSynthesisTimeoutMs": 90000,
        "expectedSelectionContractVersion": "taxonomy-cohort-v5",
        "expectedSelectionModel": "openai/gpt-4.1-mini",
        "expectedSelectionEscalationModel": "openai/gpt-5.4-mini",
        "expectedSelectionVerificationModel": "openai/gpt-5.4-mini",
        "expectedSelectionVerificationMode": "individual-semantic",
        "expectedSelectionBatching": "taxonomy-cohort",
        "expectedCollectionRecordClass": "employee_performance_evaluation",
        "expectedBoundaryContractVersion": "semantic-boundary-v3",
        "expectedBoundaryModel": "openai/gpt-5.4-mini",
        "expectedBoundaryMethod": "semantic-canonicalization",
        "expectedAdvisorContractVersion": "executive-advisor-v12",
        "expectedAdvisorJudgeModel": "openai/gpt-5.4-mini",
        "requireAdvisorContractPassed": true,
        "minimumAdvisorScore": 80,
        "maximumAdvisorAttempts": 4,
        "minimumAdvisorSemanticScore": 4,
        "minimumAdvisorThesisSpecificity": 5,
        "minimumAdvisorExecutiveVoice": 5,
        "expectedArchitecture": "retrieval-planner-v2",
        "expectedProviderPath": "semantic-collection-analysis"
      }
    }
  ]
}
