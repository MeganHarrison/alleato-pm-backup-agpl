{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alleato.local/schemas/operational-loss-episode-v1.json",
  "title": "Operational Loss Calibration Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "window", "exclusionLedger", "episodes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["since", "until"],
      "properties": {
        "since": { "type": "string", "format": "date-time" },
        "until": { "type": "string", "format": "date-time" }
      }
    },
    "exclusionLedger": { "type": "string", "minLength": 1 },
    "episodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/episode" }
    }
  },
  "$defs": {
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["occurrence", "consequence", "causal"],
      "properties": {
        "occurrence": { "enum": ["high", "medium", "low"] },
        "consequence": { "enum": ["high", "medium", "low"] },
        "causal": { "enum": ["high", "medium", "low"] }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentId", "expectedProjectId", "occurredOn", "grade", "supports"],
      "properties": {
        "documentId": { "type": "string", "minLength": 1 },
        "expectedProjectId": { "type": ["integer", "null"] },
        "occurredOn": { "type": "string", "format": "date" },
        "grade": { "enum": ["A", "B", "C", "D"] },
        "supports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["occurrence", "consequence", "causal", "resolution", "counterexample"] }
        },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "status", "value", "unit", "method"],
      "properties": {
        "dimension": { "enum": ["time", "energy", "money", "relationship", "productivity", "schedule"] },
        "status": { "enum": ["confirmed", "estimated", "unknown"] },
        "value": { "type": ["number", "null"], "minimum": 0 },
        "unit": { "type": ["string", "null"] },
        "method": { "type": "string", "minLength": 1 }
      }
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "kind", "projectId", "projectName", "workflow", "pattern",
        "startedOn", "endedOn", "expectedState", "firstBreakdown", "trigger",
        "contributingConditions", "consequences", "impacts", "roles",
        "earliestSignal", "resolution", "preventability", "confidence",
        "evidence", "review"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^ole-[a-z0-9-]+$" },
        "kind": { "enum": ["failure", "healthy_counterexample"] },
        "projectId": { "type": ["integer", "null"] },
        "projectName": { "type": "string", "minLength": 1 },
        "workflow": { "type": "string", "minLength": 1 },
        "pattern": {
          "enum": [
            "approval_latency", "ownership_handoff", "scope_change_leakage",
            "missing_information", "rework", "procurement_lead_time",
            "schedule_coordination", "billing_cash_delay",
            "client_expectation_drift", "system_fragmentation_capacity"
          ]
        },
        "startedOn": { "type": "string", "format": "date" },
        "endedOn": { "type": ["string", "null"], "format": "date" },
        "expectedState": { "type": "string", "minLength": 1 },
        "firstBreakdown": { "type": "string", "minLength": 1 },
        "trigger": { "type": "string", "minLength": 1 },
        "contributingConditions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "consequences": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "impacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/impact" } },
        "roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "earliestSignal": { "type": "string", "minLength": 1 },
        "resolution": { "type": "string", "minLength": 1 },
        "preventability": { "enum": ["high", "medium", "low", "unknown"] },
        "confidence": { "$ref": "#/$defs/confidence" },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reviewer", "reviewedOn", "notes"],
          "properties": {
            "status": { "enum": ["seed_reviewed", "needs_review", "excluded"] },
            "reviewer": { "type": "string", "minLength": 1 },
            "reviewedOn": { "type": "string", "format": "date" },
            "notes": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
