# GitHub App credentials. Create a GitHub App (Settings > Developer settings >
# GitHub Apps), then fill these in through the deployment target's environment
# variables.
#
# REQUIRED GitHub App setup:
#   Repository permissions:
#     - Pull requests: Read & write
#     - Metadata: Read-only
#   Subscribe to events: Pull request
#   Webhook: URL https://<deployment>/eve/v1/github, secret = GITHUB_WEBHOOK_SECRET
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Optional. Only needed if you later enable @mention-driven turns.
# GITHUB_APP_SLUG=

# Model credential. Easiest is Vercel AI Gateway once the project is linked.
# ANTHROPIC_API_KEY=
