{
  "name": "training-video",
  "private": true,
  "type": "module",
  "description": "Automated, repeatable training-video recorder for the Alleato PM app",
  "scripts": {
    "record": "node lib/record.mjs",
    "record:prime-contract": "node lib/record.mjs flows/create-prime-contract.json",
    "preflight": "node lib/preflight.mjs",
    "preflight:prime-contract": "node lib/preflight.mjs flows/create-prime-contract.json",
    "test": "node --test lib/__tests__/*.test.mjs"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "playwright": "^1.58.1"
  }
}
