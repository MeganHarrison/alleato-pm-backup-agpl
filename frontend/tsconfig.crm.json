{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "next-env.d.ts",
    "src/app/(main)/crm/**/*.ts",
    "src/app/(main)/crm/**/*.tsx",
    "src/app/api/crm/**/*.ts",
    "src/app/api/cron/crm-health/route.ts",
    "src/app/api/document-picker/attach/route.ts",
    "src/app/api/projects/route.ts",
    "src/app/api/tasks/**/*.ts",
    "src/components/domain/crm/company-crm-sections.tsx",
    "src/features/crm/**/*.ts",
    "src/features/crm/**/*.tsx",
    "src/hooks/use-crm/**/*.ts",
    "src/lib/crm/**/*.ts",
    "src/lib/documents/pattern-c-attachments.ts",
    "src/types/database.types.ts"
  ],
  "exclude": ["node_modules", ".next", "**/__tests__/**", "**/*.test.ts", "**/*.test.tsx"]
}
