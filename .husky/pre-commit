#!/usr/bin/env sh

# Fast, staged-scope pre-commit gate. Global builds, typechecks, and regression
# suites belong in CI or one explicit release checkpoint.
set -e

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

has_staged() {
  printf '%s\n' "$STAGED_FILES" | grep -Eq "$1"
}

# Keep generated notes and ad-hoc scripts out of the repository root.
ALLOWED_ROOT="README.md|CLAUDE.md|AGENTS.md|CONTRIBUTING.md|CONTEXT.md|WORKING_CONTEXT.md|PRODUCT.md|DESIGN.md|CHANGELOG.md|LICENSE|LICENSE.md|.lintstagedrc.js"
STRAY_FILES=$(printf '%s\n' "$STAGED_FILES" | grep -E "^[^/]+\.(md|js|jsx|ts|tsx|mjs|cjs|py|sh|html)$" | grep -Ev "^($ALLOWED_ROOT)$" || true)
if [ -n "$STRAY_FILES" ]; then
  echo "ERROR: staged root files belong under docs/, scripts/, or frontend/:"
  printf '%s\n' "$STRAY_FILES"
  exit 1
fi

node scripts/audits/check-no-new-retired-artifacts.mjs --staged

# Route inventory work is expensive in this app. Run it only when the staged
# change can alter the route graph or its production budget.
if [ "${CODEX_TARGETED_ROUTE_CHECKS_COMPLETE:-0}" != "1" ] && has_staged '^(frontend/src/app/.+/(page|route)\.(ts|tsx)|frontend/scripts/build/nonprod-routes\.json|scripts/check-route-conflicts\.sh|scripts/build/check-nonprod-routes\.mjs)$'; then
  npm run check:routes
  npm run verify:nonprod-routes
fi

# Database-reference checks only apply to code or schema changes.
if has_staged '^(frontend/.*\.(ts|tsx|js|jsx)|backend/.*\.py|supabase/migrations/.*\.sql)$'; then
  node scripts/audits/check-no-new-phantom-tables.mjs --staged
fi

if has_staged '^(docs/.*\.md|README\.md|AGENTS\.md|CLAUDE\.md)$'; then
  node scripts/audits/check-no-phantom-doc-tables.mjs --staged
fi

# Production-specialized guards run only when their owner surfaces change.
#
# check-pdf-route-tracing.mjs was retired on 2026-07-31. It enforced the
# now-reversed policy of force-tracing @sparticuz/chromium's ~66 MB bin archive
# into all 19 PDF/email routes. Commit 6647417 removed that tracing on purpose —
# src/lib/documents/pdf.ts downloads a version-pinned remote pack when no bundled
# binary is present — but left the guard behind, so it failed on an unmodified
# main and blocked every commit that touched next.config.ts.
#
# The correct invariant is now asserted in CI by
# frontend/src/lib/documents/__tests__/pdf.unit.test.ts
# ("keeps Chromium out of per-route output tracing"), which checks the opposite
# of what this guard required. Do not reinstate the guard without first deleting
# that test — they cannot both be satisfied.

# Build-memory boundary: next.config.ts declares source maps off, but
# @sentry/nextjs overrides `webpack.devtool` unless `sourcemaps.disable` is set.
# The declared value and the resolved value disagree, so only a probe that runs
# the real webpack hook can tell them apart. This guard has already caught one
# silent removal of that line by a concurrent session (2026-07-31).
if has_staged '^frontend/next\.config\.(js|mjs|ts)$'; then
  (cd frontend && npx tsx scripts/build/probe-webpack-devtool.mts)
fi

if has_staged '^(frontend/vercel\.json|frontend/src/app/api/.+/route\.(ts|tsx))$'; then
  node scripts/audits/check-cron-route-methods.mjs
fi

if has_staged '^(frontend/src/app/.*page\.(ts|tsx)|frontend/src/lib/.*(server|supabase).*\.(ts|tsx))$'; then
  node scripts/check-server-prerender-safety.mjs
  node scripts/check-no-module-level-server-init.mjs
fi

if has_staged '^backend/src/services/intelligence/'; then
  node scripts/audits/check-no-select-star-intelligence.mjs
fi

if git diff --cached --summary | grep -Eq '(create mode 120000|mode change .*120000)'; then
  node scripts/audits/check-symlinks.mjs
fi

if has_staged '^(supabase/|docs/(architecture|ops)/.*(rag|RAG)|backend/src/.*(rag|intelligence)|frontend/src/.*(rag|intelligence))'; then
  sh .husky/pre-commit-rag-docs
fi

if has_staged '^(frontend/src/app/.+/(page|route)\.(ts|tsx)|frontend/src/lib/ai/tools/)'; then
  sh .husky/pre-commit-project-map
fi

# lint-staged already scopes ESLint and TypeScript debt checks to staged files.
npx lint-staged
